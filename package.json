{
  "name": "promptwash",
  "version": "0.2.0",
  "description": "Local-first prompt engineering toolkit for cleaning, analyzing, optimizing, validating, benchmarking, and managing prompts.",
  "type": "module",
  "bin": {
    "promptwash": "./bin/promptwash.js",
    "pw": "./bin/promptwash.js"
  },
  "scripts": {
